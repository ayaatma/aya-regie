{
  "name": "lototekno-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Admin UI for the Loto Tekno volunteer planning tool.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
